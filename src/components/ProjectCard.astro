---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import type { Locale } from "../i18n";

interface Props {
  project: CollectionEntry<"projects">;
  lang: Locale;
}

const { project, lang } = Astro.props;
const { title, summary, category, cover } = project.data;
---

<a
  href={`/${lang}/projects/${project.id}/`}
  class="block overflow-hidden rounded-2xl border transition-colors hover:bg-[var(--bg-muted)]"
  style="border-color: var(--border);"
>
  {cover && <Image src={cover} alt={title[lang]} loading="lazy" class="aspect-[16/9] w-full object-cover" />}
  <div class="p-5">
    <span class="text-xs font-medium uppercase tracking-wide" style="color: var(--fg-muted);">
      {category}
    </span>
    <h3 class="mt-1 font-serif text-xl font-semibold" style="color: var(--fg);">{title[lang]}</h3>
    <p class="mt-2 text-sm" style="color: var(--fg-muted);">{summary[lang]}</p>
  </div>
</a>
