---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Алекс — Портфолио" lang="ru">
  <main class="mx-auto flex min-h-[calc(100vh-8rem)] max-w-3xl flex-col items-center justify-center gap-4 px-4 text-center sm:px-6">
    <p class="rounded-full px-3 py-1 text-xs font-medium" style="background-color: var(--color-brand-100); color: var(--color-brand-700);">
      Портфолио · в разработке
    </p>
    <h1 class="font-serif text-4xl font-semibold tracking-tight sm:text-5xl">Привет, я Алекс 👋</h1>
    <p class="max-w-xl text-lg" style="color: var(--fg-muted);">
      BA/PM, перехожу в AI-консалтинг и solutions engineering. Проекты, кейсы и немного
      вайб-кодинга — скоро появятся на этой странице.
    </p>
  </main>
</BaseLayout>
