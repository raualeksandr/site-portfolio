---
import { getEntry } from "astro:content";
import { useTranslations, type Locale } from "../i18n";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
const t = useTranslations(lang);
const about = await getEntry("about", "main");

// Sourced from src/content/about.json — fill in real values there; a
// browser CMS (Keystatic, Day 6) takes over editing this later.
const socials = [
  about?.data.socials.github && { label: "GitHub", href: about.data.socials.github },
  about?.data.socials.linkedin && { label: "LinkedIn", href: about.data.socials.linkedin },
  about?.data.socials.email && { label: "Email", href: `mailto:${about.data.socials.email}` },
].filter((s): s is { label: string; href: string } => Boolean(s));

const resumeHref = about?.data.resume ?? "/resume.pdf";
---

<footer class="border-t" style="border-color: var(--border);">
  <div
    class="mx-auto flex max-w-3xl flex-col items-center gap-3 px-4 py-6 text-sm sm:flex-row sm:justify-between sm:px-6"
    style="color: var(--fg-muted);"
  >
    <p>&copy; {year} · {t("footer.rights")}</p>
    <nav class="flex flex-wrap items-center justify-center gap-4">
      {socials.map((s) => (
        <a href={s.href} target="_blank" rel="noopener noreferrer" class="hover:underline">
          {s.label}
        </a>
      ))}
      <a href={resumeHref} class="hover:underline">{t("footer.resume")}</a>
    </nav>
  </div>
</footer>
