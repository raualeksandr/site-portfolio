---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../i18n";

interface Props {
  project: CollectionEntry<"projects">;
  lang: Locale;
}

const { project, lang } = Astro.props;
const { title, summary, category } = project.data;
---

<a
  href={`/${lang}/projects/${project.id}/`}
  class="block rounded-2xl border p-5 transition-colors hover:bg-[var(--bg-muted)]"
  style="border-color: var(--border);"
>
  <span class="text-xs font-medium uppercase tracking-wide" style="color: var(--fg-muted);">
    {category}
  </span>
  <h3 class="mt-1 font-serif text-xl font-semibold" style="color: var(--fg);">{title[lang]}</h3>
  <p class="mt-2 text-sm" style="color: var(--fg-muted);">{summary[lang]}</p>
</a>
